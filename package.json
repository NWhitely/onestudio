{
  "type": "module",
  "name": "onestudio",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently --raw --kill-others \"cd server && npm run dev\" \"cd client && npm run dev\"",
    "start": "node server/index.js",
    "prisma:generate": "npx prisma generate --schema=server/prisma/schema.prisma",
    "prisma:migrate": "npx prisma migrate dev --schema=server/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "axios": "^1.8.4",
    "concurrently": "^7.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "google-auth-library": "^9.15.1",
    "jwt-decode": "^4.0.0",
    "prisma": "^6.6.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  },
  "license": "UNLICENSED"
}
